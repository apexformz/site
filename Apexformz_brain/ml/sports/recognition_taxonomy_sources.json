  "interpretation_rules": [
    "Sources justify terminology and related actions; proposed groups are engineering inferences, not federation-approved model classifications.",
    "Keep exact catalogue movement identities unchanged. A closest match must be labelled approximate.",
    "Prefer observable direction, stroke side, limb configuration and temporal pattern in broad names.",
    "Attack/defence, court destination, ball bounce, contact, spin and shot outcome require their own evidence; do not fabricate these from body skeletons.",
    "A camera-relative forward movement is not automatically movement toward the front wall. Court coordinates or a known view are needed.",
    "Keep static and dynamic members in separate families under the existing contract.",
    "Grouping does not add missing trained classes or validate thresholds.",
    "No subject, unusable pose, ambiguous identity and unsupported motion can still produce no reliable label."
  ],
  "squash_recommendations": [
    {
      "recommendation": "Retain forehand/backhand stroke families and separate travel/recovery families where the corrected pose data supports them.",
      "source_ids": [
        "squash_nz_drive",
        "squash_nz_lob"
      ]
    },
    {
      "recommendation": "Use names such as forehand stroke, backhand stroke, forward lunge, lateral travel and recovery steps. Broader labels should not claim attacking/defensive intent.",
      "source_ids": [
        "squash_nz_drive",
        "squash_nz_lob"
      ]
    },
    {
      "recommendation": "Keep straight/cross-court drive, volley, drop, boast and lob exact labels, but allow a common stroke group when body motion cannot establish ball/racket context.",
      "source_ids": [
        "squash_nz_drive",

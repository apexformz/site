// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password_hash   String
  name            String
  avatar_url      String?
  preferred_sport String   @default("cricket")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  stats           UserStats?
  sessions        TrainingSession[]
  achievements    Achievement[]
  leaderboard     LeaderboardEntry[]
  refresh_tokens  RefreshToken[]
  
  enhanced_streak EnhancedStreak?
  circle_members  CircleMember[]
  circle_activities CircleActivity[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserStats {
  id             String   @id @default(uuid())
  user_id        String   @unique
  xp             Int      @default(0)
  level          Int      @default(1)
  streak         Int      @default(0)
  longest_streak Int      @default(0)
  total_sessions Int      @default(0)
  best_score     Float    @default(0)
  last_session_date DateTime?
  updated_at     DateTime @updatedAt

  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Achievement {
  id         String   @id @default(uuid())
  user_id    String
  type       String
  earned_at  DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, type])
}

model TrainingSession {
  id               String   @id @default(uuid())
  user_id          String
  sport            String
  duration_s       Int      @default(0)
  score            Float    @default(0)
  feedback_summary String   @default("")
  xp_earned        Int      @default(0)
  frame_count      Int      @default(0)
  created_at       DateTime @default(now())

  user             User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  frames           PoseFrame[]
}

model PoseFrame {
  id           String   @id @default(uuid())
  session_id   String
  timestamp_ms Int
  keypoints    Json
  angles       Json
  feedback     Json
  frame_score  Float    @default(0)
  created_at   DateTime @default(now())

  session      TrainingSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model LeaderboardEntry {
  id         String   @id @default(uuid())
  user_id    String
  sport      String
  weekly_xp  Int      @default(0)
  all_time_xp Int     @default(0)
  rank       Int      @default(0)
  updated_at DateTime @updatedAt

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, sport])
}

// ----------------------------------------------------
// NEW STREAK ENGINE MODELS
// ----------------------------------------------------

model EnhancedStreak {
  id                  String   @id @default(uuid())
  user_id             String   @unique
  current_streak      Int      @default(0)   // The validated streak
  longest_streak      Int      @default(0)
  risk_score          Float    @default(0)   // 0-100, measures drop-off probability
  save_tokens         Int      @default(0)   // Earned streak insurance
  identity_tier       String   @default("Novice") // Beginner, Consistent, Athlete, Elite
  last_valid_session  DateTime?
  updated_at          DateTime @updatedAt

  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Circle {
  id                  String   @id @default(uuid())
  name                String
  shared_streak       Int      @default(0)
  circle_health       Float    @default(100) // 0-100, drops if a member misses
  created_at          DateTime @default(now())
  
  members             CircleMember[]
  activities          CircleActivity[]
}

model CircleMember {
  id                  String   @id @default(uuid())
  circle_id           String
  user_id             String
  role                String   @default("member") // anchor_user, at_risk_user, member
  joined_at           DateTime @default(now())

  circle              Circle   @relation(fields: [circle_id], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@unique([circle_id, user_id])
}

model CircleActivity {
  id                  String   @id @default(uuid())
  circle_id           String
  user_id             String
  session_id          String
  posture_score       Float
  improvement_delta   Float    @default(0)
  duration_s          Int
  created_at          DateTime @default(now())

  circle              Circle   @relation(fields: [circle_id], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// APEXFORMZ BRAIN V1 MODELS (TRD 13 relational schema)
// Legacy models above are retained unchanged.
// ----------------------------------------------------

model BrainSession {
  id           String    @id
  athlete_id   String
  sport_id     String
  pack_version String
  movement_id  String
  status       String    @default("ACTIVE") // ACTIVE | COMPLETED | FAILED
  started_at   DateTime  @default(now())
  ended_at     DateTime?
  summary      Json?
  created_at   DateTime  @default(now())

  events       SessionEvent[]
  executions   MovementExecution[]
  assessments  CriterionAssessment[]

  @@index([athlete_id, sport_id])
}

model SessionEvent {
  id             String   // event_id from the client outbox, scoped to a session
  session_id     String
  monotonic_ms   Float
  event_type     String
  payload_schema String
  payload        Json
  sequence       Int?
  ingested_at    DateTime @default(now())

  session        BrainSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@id([session_id, id])
  @@index([session_id, sequence])
}

model MovementExecution {
  id             String   @id @default(uuid())
  session_id     String
  movement_id    String
  start_ms       Float
  end_ms         Float?
  model_versions Json
  state          String
  created_at     DateTime @default(now())

  session        BrainSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
}

model CriterionAssessment {
  id             String   @id @default(uuid())
  execution_id   String?
  session_id     String
  criterion_id   String
  status         String   // PASS | IMPROVE | UNCERTAIN | NOT_ASSESSABLE | NOT_APPLICABLE
  score          Float?
  rubric_version String
  evidence_ref   Json
  created_at     DateTime @default(now())

  session        BrainSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, criterion_id])
}

model ModelRelease {
  id            String   @id @default(uuid())
  sport_id      String
  semver        String
  digest        String
  signature     String
  compatibility Json     // { minimum_core_version, platforms[], contract_version }
  rollout       Json     // { stage, percentage, device_classes[] }
  created_at    DateTime @default(now())

  @@unique([sport_id, semver])
}

model AnalysisJob {
  id            String   @id @default(uuid())
  owner_id      String
  asset_ref     String?
  consent_scope String
  status        String   @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | RETRYABLE
  output_ref    String?
  error         String?
  attempts      Int      @default(0)
  request       Json?
  remote_id     String?
  output        Json?
  next_attempt_at DateTime?
  lease_token   String?
  lease_expires_at DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([status, updated_at])
  @@index([status, next_attempt_at, lease_expires_at])
}

model ObjectAsset {
  id                  String   @id @default(uuid())
  owner_id            String
  storage_key         String   @unique
  hash                String
  retention_policy    String
  encryption_metadata Json
  content_type        String   @default("application/octet-stream")
  byte_size           Int      @default(0)
  version_id          String?
  consent_scope       String   @default("deep_analysis")
  status              String   @default("QUARANTINED")
  expires_at          DateTime?
  delete_after        DateTime?
  deleted_at          DateTime?
  created_at          DateTime @default(now())

  @@index([status, expires_at, delete_after])
}

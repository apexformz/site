{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexformz.ai/schemas/equipment_measurement.schema.json",
  "title": "EquipmentMeasurementFrame",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "camera_id", "tracked_subject_id", "view", "frame_id", "timestamp_ms", "image_size", "mirror", "orientation", "retrospective", "measurements"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "session_id": {"type": "string", "minLength": 1},
    "camera_id": {"type": "string", "minLength": 1},
    "tracked_subject_id": {"type": "string", "minLength": 1},
    "view": {"$ref": "common.schema.json#/$defs/view_label"},
    "frame_id": {"type": "integer", "minimum": 0},
    "timestamp_ms": {"type": "number", "minimum": 0},
    "image_size": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
    "mirror": {"type": "boolean"},
    "orientation": {"type": "string", "enum": ["portrait", "landscape", "portrait_flipped", "landscape_flipped", "unknown"]},
    "retrospective": {"type": "boolean"},
    "measurements": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/measurement"}}
  },
  "$defs": {
    "contact": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "event", "source_id", "version", "frame_id", "timestamp_ms", "confidence"],
      "properties": {
        "kind": {"enum": ["sensor", "reviewed_annotation"]},
        "event": {"enum": ["implement_projectile", "foot_ground"]},
        "source_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "frame_id": {"type": "integer", "minimum": 0},
        "timestamp_ms": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["measurement_id", "equipment_id", "quantity", "value", "unit", "confidence", "source", "validation_status"],
      "properties": {
        "measurement_id": {"type": "string", "minLength": 1},
        "equipment_id": {"type": "string", "minLength": 1},
        "quantity": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"$ref": "common.schema.json#/$defs/unit"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source": {"$ref": "common.schema.json#/$defs/model_provenance"},
        "validation_status": {"$ref": "common.schema.json#/$defs/validation_status"},
        "contact": {"$ref": "#/$defs/contact"},
        "ground_contact": {"$ref": "#/$defs/contact"},
        "calibration_id": {"type": "string", "minLength": 1}
      }
    }
  }
}

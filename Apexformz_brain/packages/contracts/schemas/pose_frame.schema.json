{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexformz.ai/schemas/pose_frame.schema.json",
  "title": "PoseFrame",
  "description": "Output of the pose worker for one camera frame (TRD 02). Image coordinates are image_normalized [0,1], origin top-left, view dependent. world_landmarks are model-estimated, NOT calibrated.",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "frame_id",
    "timestamp_ms",
    "camera_id",
    "image_size",
    "mirror",
    "orientation",
    "landmark_set",
    "normalized_landmarks",
    "quality",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "session_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "frame_id": {
      "$ref": "common.schema.json#/$defs/frame_id"
    },
    "timestamp_ms": {
      "$ref": "common.schema.json#/$defs/monotonic_ms"
    },
    "camera_id": {
      "type": "string",
      "minLength": 1
    },
    "image_size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[width, height] in pixels"
    },
    "mirror": {
      "type": "boolean",
      "description": "True when the image fed to the model was horizontally flipped (selfie view). Metadata only; reflect coordinates exactly once downstream."
    },
    "orientation": {
      "type": "string",
      "enum": [
        "landscape",
        "portrait",
        "landscape_flipped",
        "portrait_flipped",
        "unknown"
      ]
    },
    "landmark_set": {
      "type": "string",
      "enum": [
        "mediapipe_pose_33",
        "coco_17",
        "halpe_26",
        "coco_wholebody_133",
        "custom"
      ]
    },
    "normalized_landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "visibility": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "presence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "world_landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "x",
          "y",
          "z"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "tracked_subject_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "quality": {
      "type": "object",
      "required": [
        "framing_ok",
        "ambiguous_people",
        "missing_joints"
      ],
      "properties": {
        "framing_ok": {
          "type": "boolean"
        },
        "ambiguous_people": {
          "type": "boolean"
        },
        "missing_joints": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "motion_blur": {
          "type": [
            "number",
            "null"
          ]
        },
        "person_count": {
          "type": "integer",
          "minimum": 0
        },
        "detection_confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "track_changed": {
          "type": "boolean"
        },
        "identity_method": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "tracker",
            "face",
            "face_track",
            "clothing",
            "size",
            "none",
            "pinned",
            "reacquired",
            "appearance",
            "sam2",
            null
          ],
          "description": "How the athlete was identified in this frame (identity-resolved extraction); absent for tracker-only extraction"
        },
        "identity_score": {
          "type": [
            "number",
            "null"
          ],
          "description": "Face similarity (face) or clothing distance (clothing) behind identity_method"
        }
      }
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/model_provenance"
    }
  }
}

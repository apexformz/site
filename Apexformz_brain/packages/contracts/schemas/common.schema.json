{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexformz.ai/schemas/common.schema.json",
  "title": "ApexFormz common contract definitions",
  "description": "Shared enumerations and primitives. All wire payloads are snake_case JSON. Version 1.0.0.",
  "$defs": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the data contract that produced this message"
    },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "monotonic_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Capture-monotonic milliseconds. Never wall clock."
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonically increasing frame index inside one camera stream (uint64 compatible)"
    },
    "coordinate_system": {
      "type": "string",
      "enum": ["image_normalized", "image_pixel", "estimated_world", "calibrated_world", "body_relative"]
    },
    "unit": {
      "type": "string",
      "enum": [
        "deg", "rad", "deg_per_s", "rad_per_s", "deg_per_s2",
        "normalized", "normalized_per_s", "normalized_per_s2", "normalized_per_s3",
        "ratio", "ms", "s", "px", "m", "m_per_s", "count", "score", "probability", "none"
      ]
    },
    "view_label": {
      "type": "string",
      "enum": ["front", "back", "left", "right", "front_left", "front_right", "back_left", "back_right", "top", "unknown"]
    },
    "view_applicability": {
      "oneOf": [
        { "const": "any" },
        { "type": "array", "items": { "$ref": "#/$defs/view_label" }, "minItems": 1, "uniqueItems": true }
      ]
    },
    "missing_reason": {
      "type": "string",
      "description": "Typed reason for a nullable measurement. Never represent missing data as zero.",
      "enum": [
        "MISSING_JOINT", "LOW_CONFIDENCE", "DEGENERATE_GEOMETRY", "VIEW_INVALID", "TIME_GAP",
        "INSUFFICIENT_HISTORY", "AMBIGUOUS_SUBJECT", "FRAMING_INVALID", "SCALE_UNKNOWN",
        "EQUIPMENT_UNOBSERVED", "CONTACT_UNOBSERVED", "TRACK_CHANGED", "STALE_FRAME",
        "RUBRIC_UNVALIDATED", "RUBRIC_DISABLED", "MODEL_UNAVAILABLE", "NOT_APPLICABLE",
        "OUTLIER_REJECTED", "PREDICTED_SAMPLE", "NORMALIZATION_INVALID", "DEPENDENCY_INVALID",
        "UNKNOWN_FEATURE", "CAPABILITY_MISSING", "PHASE_NOT_ACTIVE", "MOVEMENT_NOT_CONFIRMED",
        "CONTRADICTORY_EVIDENCE", "COVERAGE_INSUFFICIENT", "HANDEDNESS_UNKNOWN", "WITHIN_NORMAL_VARIANCE"
      ]
    },
    "error_code": {
      "type": "string",
      "enum": [
        "CONTRACT_VERSION_INCOMPATIBLE", "SCHEMA_INVALID", "UNKNOWN_MODEL_ID", "UNKNOWN_SPORT_PACK",
        "PACK_INCOMPATIBLE", "ASSET_HASH_MISMATCH", "SIGNATURE_INVALID", "PACK_ACTIVATION_LOCKED",
        "PACK_VALIDATION_FAILED", "TIMESTAMP_REGRESSION", "DUPLICATE_FRAME", "TIME_GAP",
        "WORKER_TIMEOUT", "CAMERA_LOST", "INVALID_TRANSITION", "DEGRADED_INPUT",
        "AMBIGUOUS_SUBJECT", "CROSS_SPORT_ACCESS", "INTERNAL"
      ]
    },
    "nullable_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "unit": { "$ref": "#/$defs/unit" },
        "reason": { "oneOf": [{ "$ref": "#/$defs/missing_reason" }, { "type": "null" }] },
        "feature_id": { "type": "string" },
        "coordinate_system": { "$ref": "#/$defs/coordinate_system" }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "null" } } },
          "then": { "required": ["reason"], "properties": { "reason": { "$ref": "#/$defs/missing_reason" } } }
        }
      ]
    },
    "model_provenance": {
      "type": "object",
      "required": ["model_id", "version"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "delegate": { "type": "string" },
        "digest": { "type": "string" }
      }
    },
    "validation_status": { "type": "string", "enum": ["approved", "provisional", "disabled"] },
    "platform": { "type": "string", "enum": ["web", "android", "ios", "desktop"] },
    "capability": {
      "type": "string",
      "enum": [
        "body_pose", "hands", "optional_implement", "optional_projectile", "optional_target_system",
        "optional_sensor", "calibrated_scale", "multi_view"
      ]
    },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "safety"] },
    "event_envelope_base": {
      "type": "object",
      "required": ["schema_version", "session_id", "event_id", "monotonic_ms", "sport_pack_id", "sport_pack_version", "producer"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "session_id": { "$ref": "#/$defs/id" },
        "event_id": { "$ref": "#/$defs/id" },
        "monotonic_ms": { "$ref": "#/$defs/monotonic_ms" },
        "wall_clock_iso": { "type": "string" },
        "sport_pack_id": { "type": "string" },
        "sport_pack_version": { "type": "string" },
        "producer": { "type": "string", "minLength": 1 }
      }
    }
  }
}

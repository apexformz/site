    { "id": "dominant_wrist_y_image", "kind": "landmark_coordinate", "params": { "landmark": "dominant_wrist", "axis": "y" }, "version": "1.0.0", "coordinate_system": "image_normalized", "view_applicability": "any", "unit": "normalized" },
    { "id": "dominant_wrist_x_image", "kind": "landmark_coordinate", "params": { "landmark": "dominant_wrist", "axis": "x" }, "version": "1.0.0", "coordinate_system": "image_normalized", "view_applicability": "any", "unit": "normalized" },
    { "id": "wrist_stability", "kind": "stability_variability", "params": { "of": "dominant_wrist_y_image", "window_ms": 1000, "stat": "std", "min_samples": 6 }, "version": "1.0.0", "coordinate_system": "image_normalized", "view_applicability": "any", "description": "Std of wrist height over 1 s; a hold-stability proxy, not sight alignment" },

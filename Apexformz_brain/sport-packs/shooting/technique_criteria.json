    { "id": "dominant_wrist_velocity", "kind": "time_derivative", "params": { "of": "dominant_wrist_y_image", "window_ms": 120, "method": "finite" }, "version": "1.0.0", "coordinate_system": "image_normalized", "view_applicability": "any" },
    { "id": "hip_centre_x_image", "kind": "center_of_keypoints", "params": { "landmarks": ["left_hip", "right_hip"], "axis": "x" }, "version": "1.0.0", "coordinate_system": "image_normalized", "view_applicability": "any", "unit": "normalized" },
    { "id": "body_motion", "kind": "stability_variability", "params": { "of": "hip_centre_x_image", "window_ms": 600, "stat": "std", "min_samples": 4 }, "version": "1.0.0", "coordinate_system": "image_normalized", "view_applicability": "any", "description": "Whole-body stillness proxy" }

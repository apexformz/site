{
  "schema_version": "1.0.0",
  "sport_id": "badminton",
  "rubric_version": "1.0.0",
  "aggregation": {
    "method": "weighted_mean_of_valid_criteria",
    "minimum_coverage": 0.6
  },
  "features": [
    {
      "id": "left_knee_angle",
      "kind": "angle_at",
      "params": {
        "a": "left_hip",
        "b": "left_knee",
        "c": "left_ankle",
        "dims": "2d"
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": "any",
      "unit": "deg",
      "description": "Interior knee angle, 180 = straight"
    },
    {
      "id": "right_knee_angle",
      "kind": "angle_at",
      "params": {
        "a": "right_hip",
        "b": "right_knee",
        "c": "right_ankle",
        "dims": "2d"
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": "any",
      "unit": "deg"
    },
    {
      "id": "lead_knee_angle",
      "kind": "min_of",
      "params": {
        "features": [
          "left_knee_angle",
          "right_knee_angle"
        ]
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": "any",
      "unit": "deg",
      "description": "The more flexed knee is treated as the lead (lunging) leg"
    },
    {
      "id": "max_knee_angle",
      "kind": "max_of",
      "params": {
        "features": [
          "left_knee_angle",
          "right_knee_angle"
        ]
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": "any",
      "unit": "deg"
    },
    {
      "id": "lead_knee_velocity",
      "kind": "angular_velocity",
      "params": {
        "of": "lead_knee_angle",
        "window_ms": 150,
        "method": "finite"
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": "any"
    },
    {
      "id": "dominant_elbow_angle",
      "kind": "angle_at",
      "params": {
        "a": "dominant_shoulder",
        "b": "dominant_elbow",
        "c": "dominant_wrist",
        "dims": "2d"
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": "any",
      "unit": "deg"
    },
    {
      "id": "dominant_elbow_velocity",
      "kind": "angular_velocity",
      "params": {
        "of": "dominant_elbow_angle",
        "window_ms": 150,
        "method": "finite"
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": "any"
    },
    {
      "id": "dominant_arm_elevation",
      "kind": "angle_at",
      "params": {
        "a": "dominant_hip",
        "b": "dominant_shoulder",
        "c": "dominant_elbow",
        "dims": "2d"
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": "any",
      "unit": "deg",
      "description": "Angle hip-shoulder-elbow; ~180 when the arm is raised straight overhead"
    },
    {
      "id": "trunk_lateral_lean",
      "kind": "line_inclination",
      "params": {
        "from": [
          "left_hip",
          "right_hip"
        ],
        "to": [
          "left_shoulder",
          "right_shoulder"
        ],
        "reference": "vertical"
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": [
        "front",
        "back"
      ],
      "unit": "deg"
    },
    {
      "id": "trunk_forward_lean",
      "kind": "line_inclination",
      "params": {
        "from": [
          "left_hip",
          "right_hip"
        ],
        "to": [
          "left_shoulder",
          "right_shoulder"
        ],
        "reference": "vertical"
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": [
        "left",
        "right"
      ],
      "unit": "deg",
      "description": "Sagittal trunk inclination; sign depends on which side faces the camera"
    },
    {
      "id": "stance_width_ratio",
      "kind": "interjoint_distance_ratio",
      "params": {
        "a": "left_ankle",
        "b": "right_ankle",
        "c": "left_shoulder",
        "d": "right_shoulder",
        "dims": "2d"
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": [
        "front",
        "back"
      ],
      "unit": "ratio"
    },
    {
      "id": "left_knee_ankle_offset_x",
      "kind": "landmark_offset",
      "params": {
        "a": "left_knee",
        "b": "left_ankle",
        "axis": "x"
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": [
        "front",
        "back"
      ],
      "unit": "normalized"
    },
    {
      "id": "right_knee_ankle_offset_x",
      "kind": "landmark_offset",
      "params": {
        "a": "right_knee",
        "b": "right_ankle",
        "axis": "x"
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": [
        "front",
        "back"
      ],
      "unit": "normalized"
    },
    {
      "id": "hip_centre_x_image",
      "kind": "center_of_keypoints",
      "params": {
        "landmarks": [
          "left_hip",
          "right_hip"
        ],
        "axis": "x"
      },
      "version": "1.0.0",
      "coordinate_system": "image_normalized",
      "view_applicability": "any",
      "unit": "normalized"
    },
    {
      "id": "hip_centre_y_image",
      "kind": "center_of_keypoints",
      "params": {
        "landmarks": [
          "left_hip",
          "right_hip"
        ],
        "axis": "y"
      },
      "version": "1.0.0",
      "coordinate_system": "image_normalized",
      "view_applicability": "any",
      "unit": "normalized"
    },
    {
      "id": "body_motion",
      "kind": "stability_variability",
      "params": {
        "of": "hip_centre_x_image",
        "window_ms": 600,
        "stat": "std",
        "min_samples": 4
      },
      "version": "1.0.0",
      "coordinate_system": "image_normalized",
      "view_applicability": "any",
      "description": "Proxy for whole-body stillness; NOT a centre-of-mass measure"
    },
    {
      "id": "hip_vertical_velocity",
      "kind": "time_derivative",
      "params": {
        "of": "hip_centre_y_image",
        "window_ms": 150,
        "method": "finite"
      },
      "version": "1.0.0",
      "coordinate_system": "image_normalized",
      "view_applicability": "any"
    },
    {
      "id": "lunge_sequencing",
      "kind": "relative_phase_timing",
      "params": {
        "features": [
          "lead_knee_angle",
          "dominant_elbow_angle"
        ],
        "window_ms": 1500
      },
      "version": "1.0.0",
      "coordinate_system": "body_relative",
      "view_applicability": "any",
      "unit": "score",
      "description": "1.0 when the lead knee reaches peak angular speed before the racket elbow"
    }
  ],

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vitest.models.config.ts",
    "tests/helpers/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "apps"
  ]
}
